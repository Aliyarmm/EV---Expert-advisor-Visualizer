# EA Index — Trading Research Platform
# Copy this file to .env.local (frontend) and .env (backend) as needed.

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE=/api/v1

# --- Backend ---
# FastAPI runs on port 8000 by default.
API_HOST=0.0.0.0
API_PORT=8000

# --- Data directory (where uploaded data files are stored) ---
DATA_DIR=./data
